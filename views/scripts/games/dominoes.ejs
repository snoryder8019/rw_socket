<script>
    document.addEventListener("DOMContentLoaded", function () {
        let spriteDataCache = {}; // Cache for sprite data
        let gameElementsCache = {}; // Cache for game elements
        let gameSessionState = {}; // Manage game state by session ID

        console.log("DOM loaded, initializing game logic...");

        // Extract game settings from cardTableGameDiv
        function extractGameSettingsData(cardTableGameDiv) {
            const gameSettings = cardTableGameDiv.getAttribute('data-game-settings');
            if (gameSettings) {
                console.log("Extracting game settings data:", gameSettings);
                return JSON.parse(gameSettings);
            } else {
                console.error('No gameSettingsData found on the cardTableGameDiv');
                return null;
            }
        }

        // Fetch sprite metadata by sprite IDs
        async function fetchSprites(spriteIds) {
            console.log("Fetching sprites with sprite IDs:", spriteIds);
            try {
                const response = await fetch('/games/gameSprites/allData');
                const sprites = await response.json();
                console.log("Sprites fetched:", sprites);

                sprites.forEach(sprite => {
                    if (spriteIds.includes(sprite._id)) {
                        spriteDataCache[sprite._id] = sprite;
                    }
                });
            } catch (error) {
                console.error('Error fetching sprites:', error);
            }
        }

        // Fetch game elements from cache or API
        async function fetchGameElements() {
            if (Object.keys(gameElementsCache).length > 0) {
                console.log("Fetching game elements from cache");
                return Object.values(gameElementsCache);
            } else {
                console.error('Game elements cache is empty.');
                return [];
            }
        }

        // Update game session state
        function updateGameState(sessionId, state) {
            console.log(`Updating game state for session ${sessionId} to '${state}'...`);
            gameSessionState[sessionId] = state;
        }

        // Setup game logic
        async function setupGame(sessionId, gameSettings) {
            console.log("Setting up game session logic...");

            const spriteIds = gameSettings.spriteIds;
            if (!spriteIds || spriteIds.length === 0) {
                console.error("No spriteIds found in gameSettings.");
                return;
            }

            await fetchSprites(spriteIds); // Fetch sprite data
            const gameElements = await fetchGameElements(); // Fetch elements data

            if (gameElements.length) {
                console.log("Game elements and sprites data loaded.");
                updateGameState(sessionId, 'playing');
            } else {
                console.error("No game elements found.");
            }
        }

        // MutationObserver to detect game div
        const observer = new MutationObserver((mutations) => {
            mutations.forEach(mutation => {
                mutation.addedNodes.forEach(async (node) => {
                    if (node.querySelector && node.querySelector('.cardTableGameDiv')) {
                        console.log("Card table detected in DOM.");
                        const gameSessionId = node.getAttribute('data-game-session-id');
                        const cardTableGameDiv = document.querySelector('.cardTableGameDiv');
                        const gameSettings = extractGameSettingsData(cardTableGameDiv);

                        if (gameSettings) {
                            await setupGame(gameSessionId, gameSettings);
                        }
                    }
                });
            });
        });

        observer.observe(document.body, { childList: true, subtree: true });

        console.log("Game logic initialized.");
    });
</script>
