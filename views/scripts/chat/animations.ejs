
<script>
    document.addEventListener('DOMContentLoaded',()=>{
  const chatContainer = document.getElementById('chatContainer')
  chatContainer.addEventListener('scroll',()=>{
    console.log(`scrolling scrollTop ${chatContainer.scrollTop}`)
    console.log(`scrolling scrollHeight ${chatContainer.scrollHeight}`)
    console.log(`scrolling clientHeight ${chatContainer.clientHeight}`)
    console.log(`cliH-cScrH ${chatContainer.scrollHeight-chatContainer.scrollTop}`)
console.log(chatContainer.scrollTop===chatContainer.scrollHeight-chatContainer.clientHeight)  

})
  
