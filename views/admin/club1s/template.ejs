<div class="adminWindow">
  <div class="adminStatsRow">
    <% documents.forEach(club1 => { %>
      <div class="adminStat">
        <p><%= club1.name %></p>
        <img alt="Club1 image" src="<%= club1.mediumIcon %>">
        <button class="collapsible">view: <span class="carrot">&#9654;</span></button>
        <div class="content" data-url="/club1s/renderEditForm/<%= club1._id %>"></div>
     <h3>add multiple images to slides</h3>
        <form action="/club1s/<%=club1._id%>/upload-images" method="post" enctype="multipart/form-data">
          <input type="file" name="images" multiple>
          <button type="submit">Upload</button>
      </form>
            </div>
    <% }) %>
  </div>
</div>


